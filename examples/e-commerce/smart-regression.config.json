{
  "testDir": "tests",
  "testMatch": ["**/*.spec.ts"],
  "pageObjectsDir": "src/pages",
  "components": [
    {
      "name": "checkout",
      "patterns": ["src/**/checkout*"]
    },
    {
      "name": "payment",
      "patterns": ["src/**/payment*"]
    },
    {
      "name": "basket",
      "patterns": ["src/**/cart*", "src/**/basket*"]
    },
    {
      "name": "profile",
      "patterns": ["src/**/profile*"]
    }
  ],
  "safetyRules": {
    "fullRunPatterns": [
      "playwright.config.*",
      "package.json"
    ],
    "maxImpactRatioForFullRun": 0.8
  },
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.5-flash",
    "temperature": 0.2
  }
}
