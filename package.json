{
  "name": "playwright-smart-test",
  "version": "1.0.5",
  "type": "module",
  "description": "AI-Powered Smart Regression Test Selection Agent for Playwright",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playwright-smart-test": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ujjwal-S-S/playwright-smart-test.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "playwright",
    "regression-testing",
    "test-impact-analysis",
    "ai-agent",
    "gemini",
    "ci-cd"
  ],
  "author": "Ujjwal S S",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "glob": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "bundleDependencies": [
    "@google/genai",
    "cli-table3",
    "commander",
    "dotenv",
    "glob",
    "picocolors",
    "zod"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}