{
  "name": "@ujjwal-s-s/smart-regression-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-Powered Smart Regression Test Selection Agent for Playwright",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smart-test": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ujjwal-S-S/smart-regression-agent.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "playwright",
    "regression-testing",
    "test-impact-analysis",
    "ai-agent",
    "gemini",
    "ci-cd"
  ],
  "author": "Ujjwal S S",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "glob": "^14.0.3",
    "picocolors": "^1.1.1",
    "ts-morph": "^10.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
